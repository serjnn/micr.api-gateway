  "cards": [
    {
      "dot": "cyan",
      "title": "Ingress & Service Discovery",
      "items": [
        "Spring Cloud Gateway on port 9000 terminates external client traffic",
        "Netflix Eureka (:8761) provides dynamic microservice registry and health monitoring"
      ]
    },
    {
      "dot": "emerald",
      "title": "Distributed SAGA Checkout",
      "items": [
        "Orchestrated 3-step checkout: Client balance -> Bucket cart -> Order details",
        "Resilience4j retries with backward compensating transactions on failures"
      ]
    },
    {
      "dot": "amber",
      "title": "Event Pipeline & Data Isolation",
      "items": [
        "Transactional Outbox in DiscountService publishes events to Apache Kafka",
        "PostgreSQL 15 with 5 isolated schemas, Redis cache, and STOMP WebSockets"
      ]
    }
